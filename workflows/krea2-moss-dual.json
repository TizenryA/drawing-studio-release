{
  "id": "krea2-moss-dual",
  "name": "Krea2 Turbo + MOSS Base 双采",
  "mode": "api",
  "workflow": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "krea2_turbo_fp8.safetensors",
        "weight_dtype": "default"
      },
      "_meta": {
        "title": "Krea2 Turbo UNET (一采底模)"
      }
    },
    "6": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_4b_fp8_scaled.safetensors",
        "type": "krea2",
        "device": "default"
      },
      "_meta": {
        "title": "Krea2 Qwen3-VL 4B CLIP"
      }
    },
    "7": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "qwen_image_vae.safetensors"
      },
      "_meta": {
        "title": "Krea2 Qwen Image VAE"
      }
    },
    "8": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "1girl, cinematic lighting, rich painterly texture, masterpiece",
        "clip": [
          "6",
          0
        ]
      },
      "_meta": {
        "title": "一采 Krea2 正向提示词"
      }
    },
    "9": {
      "class_type": "ConditioningZeroOut",
      "inputs": {
        "conditioning": [
          "8",
          0
        ]
      },
      "_meta": {
        "title": "一采零化负向条件"
      }
    },
    "10": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 896,
        "height": 1280,
        "batch_size": 1
      },
      "_meta": {
        "title": "一采 Krea2 空 Latent"
      }
    },
    "11": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 999,
        "steps": 8,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0,
        "model": [
          "1",
          0
        ],
        "positive": [
          "8",
          0
        ],
        "negative": [
          "9",
          0
        ],
        "latent_image": [
          "10",
          0
        ]
      },
      "_meta": {
        "title": "一采 Krea2 Turbo (8步 / CFG 1.0)"
      }
    },
    "12": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "11",
          0
        ],
        "vae": [
          "7",
          0
        ]
      },
      "_meta": {
        "title": "一采 Krea2 解码"
      }
    },
    "21": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "moss_image_base_bf16.safetensors",
        "weight_dtype": "default"
      },
      "_meta": {
        "title": "MOSS Base UNET (bf16 二采底模)"
      }
    },
    "22": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {
        "model": [
          "21",
          0
        ],
        "shift": 5.0,
        "sampling": "flow"
      },
      "_meta": {
        "title": "MOSS 流调度 (Shift 5.0)"
      }
    },
    "25": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3.5_9b_int8_convrot.safetensors",
        "type": "moss_image",
        "device": "default"
      },
      "_meta": {
        "title": "MOSS Qwen 3.5 9B CLIP"
      }
    },
    "26": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "flux2-vae.safetensors"
      },
      "_meta": {
        "title": "Flux2 / MOSS VAE"
      }
    },
    "27": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "1girl, cinematic lighting, rich painterly texture, masterpiece",
        "clip": [
          "25",
          0
        ]
      },
      "_meta": {
        "title": "二采 MOSS 正向提示词"
      }
    },
    "28": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "lowres, blurry, bad anatomy, text, watermark, photorealistic, photo, 3d render",
        "clip": [
          "25",
          0
        ]
      },
      "_meta": {
        "title": "二采 MOSS 负向提示词"
      }
    },
    "29": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": [
          "12",
          0
        ],
        "vae": [
          "26",
          0
        ]
      },
      "_meta": {
        "title": "跨模型 VAE 重编码 (Krea2 → MOSS)"
      }
    },
    "30": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 999,
        "steps": 28,
        "cfg": 3.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 0.55,
        "model": [
          "22",
          0
        ],
        "positive": [
          "27",
          0
        ],
        "negative": [
          "28",
          0
        ],
        "latent_image": [
          "29",
          0
        ]
      },
      "_meta": {
        "title": "二采 MOSS 重绘精修"
      }
    },
    "31": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "30",
          0
        ],
        "vae": [
          "26",
          0
        ]
      },
      "_meta": {
        "title": "二采 MOSS 解码"
      }
    },
    "32": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "Krea2_MOSS_Dual",
        "images": [
          "31",
          0
        ]
      },
      "_meta": {
        "title": "保存双采图像"
      }
    }
  },
  "mapping": {
    "prompt": [
      {
        "node": "8",
        "input": "text"
      },
      {
        "node": "27",
        "input": "text"
      }
    ],
    "negative_prompt": {
      "node": "28",
      "input": "text"
    },
    "seed": [
      {
        "node": "11",
        "input": "seed"
      },
      {
        "node": "30",
        "input": "seed"
      }
    ],
    "steps": {
      "node": "30",
      "input": "steps"
    },
    "cfg": {
      "node": "30",
      "input": "cfg"
    },
    "sampler": {
      "node": "30",
      "input": "sampler_name"
    },
    "scheduler": {
      "node": "30",
      "input": "scheduler"
    },
    "denoise": {
      "node": "30",
      "input": "denoise"
    },
    "width": {
      "node": "10",
      "input": "width"
    },
    "height": {
      "node": "10",
      "input": "height"
    },
    "batch_size": {
      "node": "10",
      "input": "batch_size"
    },
    "shift": {
      "node": "22",
      "input": "shift"
    }
  },
  "import_notes": "Krea2 Turbo（一采构图/电影光影，8步 CFG 1.0）+ MOSS Base（二采厚涂与角色重绘，AuraFlow shift=5.0）纯净双采工作流。仅依赖 HuggingFace 公开基础模型；二采重绘强度 denoise 建议 0.45~0.65，在绘图面板叠加的 MOSS LoRA 会自动串接在二采分支上。",
