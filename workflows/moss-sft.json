        "height": 1248,
        "batch_size": 1
      },
      "_meta": {
        "title": "MOSS SFT 空 Latent"
      }
    },
    "9": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 999,
        "steps": 28,
        "cfg": 3.5,
        "sampler_name": "er_sde",
        "scheduler": "simple",
        "denoise": 1.0,
        "model": [
          "2",
          0
        ],
        "positive": [
          "6",
          0
        ],
        "negative": [
          "7",
          0
        ],
        "latent_image": [
          "8",
          0
        ]
      },
      "_meta": {
        "title": "KSampler (SFT)"
      }
    },
    "10": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "9",
          0
        ],
        "vae": [
          "5",
          0
        ]
      },
      "_meta": {
        "title": "VAE 解码"
      }
    },
    "11": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "MOSS_SFT",
        "images": [
          "10",
          0
        ]
      },
      "_meta": {
        "title": "保存图像"
      }
    }
  },
